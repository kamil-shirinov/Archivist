# Copy to .env (which git ignores) only to use the local live-reading app with real model calls:
#   uv run --group glimmer python -m archivist.live
# The live demo, the replay and Docker need none of this: no key, no model call, no .env.
# Never commit .env or paste a key anywhere else.

# Meta Model API key: Muse Spark 1.3 and SAM 3.1, used by every live read.
META_API_KEY=
# Baseten key: Muse Spark Open, only for the open-weights reads.
BASETEN_API_KEY=
# Fireworks key: optional, Fireworks was dropped as a host (D56) and no committed run uses it.
FIREWORKS_API_KEY=

# Spend caps in USD, enforced in code against results/spend_ledger.jsonl. Left out (unset), each
# backend uses its own default; set one only to change it, and never to an empty value.
# BUDGET_CAP_USD=120        # Meta's API
# BASETEN_CAP_USD=80        # Baseten
# FIREWORKS_CAP_USD=40      # Fireworks
# GLIMMER_CAP_USD=10        # Muse Glimmer's page sorting on Modal (keep at or below 10)

# Muse Glimmer's sorter also needs Modal's own login, made with `modal token new`; it is not read from .env.
